#[nomain]

func add(a:int, b:int) -> int {
    return a + b;
}

func multiply(a:int, b:int) -> int {
    return a * b;
}

func nested_loop_sum(max_i:int, max_j:int) -> int {
    let max_i_copy:int = max_i;
    let max_j_copy:int = max_j;
    let sum:int = 0;
    let i:int = 1;
    while (i <= max_i_copy) {
        let j:int = 1;
        while (j <= max_j_copy) {
            let product:int = multiply(i, j);
            sum = add(sum, product);
            j = j + 1;
        }
        i = i + 1;
    }
    return sum;
}