// C-style for loop demonstration
func main() -> void {
    print("=== For Loop Demonstration ===\n\n");
    
    // Basic counting loop
    print("Counting from 1 to 10:\n");
    let i: int = 0;
    for (let i: int = 1; i <= 10; i = i + 1) {
        print(i);
        print(" ");
    }
    print("\n\n");
    
    // Countdown
    print("Countdown from 10 to 1:\n");
    for (let i: int = 10; i >= 1; i = i - 1) {
        print(i);
        print(" ");
    }
    print("\n\n");
    
    // Sum with for loop
    print("Sum of 1 to 100:\n");
    let sum: int = 0;
    for (let i: int = 1; i <= 100; i = i + 1) {
        sum = sum + i;
    }
    print("Sum = ");
    print(sum);
    print("\n\n");
    
    // Multiplication table
    print("Multiplication table for 7:\n");
    for (let i: int = 1; i <= 10; i = i + 1) {
        let result: int = 7 * i;
        print("7 x ");
        print(i);
        print(" = ");
        print(result);
        print("\n");
    }
    
    // Nested for loops
    print("\nNested loops (simple pattern):\n");
    for (let i: int = 1; i <= 5; i = i + 1) {
        for (let j: int = 1; j <= i; j = j + 1) {
            print("*");
        }
        print("\n");
    }
    
    print("\n=== Test Complete ===\n");
}
