// Fibonacci sequence (first 10 numbers)
func main() -> int {
    let f0: int = 0;
    let f1: int = 1;
    let f2: int;
    let f3: int;
    let f4: int;
    let f5: int;
    let f6: int;
    let f7: int;
    let f8: int;
    let f9: int;
    f2 = f0 + f1;
    f3 = f1 + f2;
    f4 = f2 + f3;
    f5 = f3 + f4;
    f6 = f4 + f5;
    f7 = f5 + f6;
    f8 = f6 + f7;
    f9 = f7 + f8;
    
    print("Fibonacci Sequence:\n");
    print(f0);
    print(", ");
    print(f1);
    print(", ");
    print(f2);
    print(", ");
    print(f3);
    print(", ");
    print(f4);
    print(", ");
    print(f5);
    print(", ");
    print(f6);
    print(", ");
    print(f7);
    print(", ");
    print(f8);
    print(", ");
    print(f9);
    print("\n");
    
    return 0;
}
