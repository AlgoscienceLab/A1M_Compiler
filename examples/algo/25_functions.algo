// Function demonstration
func add(a: int, b: int) -> int {
    return a + b;
}

func subtract(a: int, b: int) -> int {
    return a - b;
}

func multiply(a: int, b: int) -> int {
    return a * b;
}

func square(n: int) -> int {
    return n * n;
}

func main() -> int {
    print("Function Demo\n");
    print("=============\n\n");
    
    let x: int = 10;
    let y: int = 5;
    
    print("x = ");
    print(x);
    print(", y = ");
    print(y);
    print("\n\n");
    
    let sum: int = add(x, y);
    print("add(x, y) = ");
    print(sum);
    print("\n");
    
    let diff: int = subtract(x, y);
    print("subtract(x, y) = ");
    print(diff);
    print("\n");
    
    let prod: int = multiply(x, y);
    print("multiply(x, y) = ");
    print(prod);
    print("\n\n");
    
    let sq: int = square(7);
    print("square(7) = ");
    print(sq);
    print("\n\n");
    
    let sq2: int = square(12);
    print("square(12) = ");
    print(sq2);
    print("\n");
    
    return 0;
}
