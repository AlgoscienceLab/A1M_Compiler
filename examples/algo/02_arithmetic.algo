// Arithmetic operations demonstration
func main() -> int {
    let a: int = 100;
    let b: int = 25;
    let sum: int = 0;
    let diff: int = 0;
    let product: int = 0;

    sum = a + b;
    diff = a - b;
    product = a * b;
    
    print("Arithmetic Demo\n");
    print("a = ");
    print(a);
    print("\n");
    print("b = ");
    print(b);
    print("\n");
    print("Sum: ");
    print(sum);
    print("\n");
    print("Difference: ");
    print(diff);
    print("\n");
    print("Product: ");
    print(product);
    print("\n");
    
    return 0;
}
