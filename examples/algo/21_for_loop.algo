// Manual loop unrolling - counting demonstration
func main() -> int {
    print("Counting Demo\n");
    print("=============\n\n");
    
    print("Counting from 1 to 10:\n");
    print(1);
    print(" ");
    print(2);
    print(" ");
    print(3);
    print(" ");
    print(4);
    print(" ");
    print(5);
    print(" ");
    print(6);
    print(" ");
    print(7);
    print(" ");
    print(8);
    print(" ");
    print(9);
    print(" ");
    print(10);
    print("\n\n");
    
    print("Even numbers 0 to 20:\n");
    print(0);
    print(" ");
    print(2);
    print(" ");
    print(4);
    print(" ");
    print(6);
    print(" ");
    print(8);
    print(" ");
    print(10);
    print(" ");
    print(12);
    print(" ");
    print(14);
    print(" ");
    print(16);
    print(" ");
    print(18);
    print(" ");
    print(20);
    print("\n");
    
    return 0;
}
