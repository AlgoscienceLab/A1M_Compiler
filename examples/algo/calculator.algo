// calculator.algo - Calculator functions using enums and utilities

enum Operation {
    OP_ADD = 1,
    OP_SUB = 2,
    OP_MUL = 3,
    OP_DIV = 4,
    OP_MAX = 5,
    OP_MIN = 6
}

func calculate(op: int, a: int, b: int) -> int {
    if (op == OP_ADD) {
        return a + b;
    }
    if (op == OP_SUB) {
        return a - b;
    }
    if (op == OP_MUL) {
        return a * b;
    }
    if (op == OP_DIV) {
        if (b == 0) {
            print("Error: Division by zero!");
            return 0;
        }
        return a / b;
    }
    if (op == OP_MAX) {
        if (a > b) return a;
        return b;
    }
    if (op == OP_MIN) {
        if (a < b) return a;
        return b;
    }
    return 0;
}

func is_even(n: int) -> int {
    let remainder = n % 2;
    if (remainder == 0) return 1;
    return 0;
}

func is_positive(n: int) -> int {
    if (n > 0) return 1;
    return 0;
}

func square(n: int) -> int {
    return n * n;
}

func cube(n: int) -> int {
    return n * n * n;
}

// Small power helper
func power(base: int, exp: int) -> int {
    let result = 1;
    for (let i = 0; i < exp; i = i + 1) {
        result = result * base;
    }
    return result;
}

