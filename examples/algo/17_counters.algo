// Multiple counter demonstration
func main() -> int {
    let count1: int = 0;
    let count2: int = 0;
    let count3: int = 0;
    let total: int = 0 ;
    
    print("Counter Demo\n");
    print("============\n\n");
    
    print("Initial counts:\n");
    print("Counter 1: ");
    print(count1);
    print("\n");
    print("Counter 2: ");
    print(count2);
    print("\n");
    print("Counter 3: ");
    print(count3);
    print("\n\n");
    
    count1 = count1 + 5;
    count2 = count2 + 10;
    count3 = count3 + 15;
    
    print("After incrementing:\n");
    print("Counter 1: ");
    print(count1);
    print("\n");
    print("Counter 2: ");
    print(count2);
    print("\n");
    print("Counter 3: ");
    print(count3);
    print("\n\n");
    
    total = count1 + count2 + count3;
    print("Total: ");
    print(total);
    print("\n");
    
    return 0;
}
