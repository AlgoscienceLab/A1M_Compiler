// Algo Language - Power Function
// Calculates power (base^exponent)

func main() -> int {
    let base = 2;
    let exponent = 10;
    let result = 1;
    let i = 0;
    
    while (i < exponent) {
        result = result * base;
        i = i + 1;
    }
    
    print("2^10 =");
    print(result);
    
    return 0;
}
