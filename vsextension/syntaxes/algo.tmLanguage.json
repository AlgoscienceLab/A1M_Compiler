{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Algo",
  "scopeName": "source.algo",
  "patterns": [
    { "include": "#comments" },
    { "include": "#preprocessor" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#constants" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.algo",
          "match": "//.*$"
        },
        {
          "name": "comment.block.algo",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "name": "meta.preprocessor.include.algo",
          "match": "^\\s*(#include)\\s+(\"[^\"]+\")",
          "captures": {
            "1": { "name": "keyword.control.directive.include.algo" },
            "2": { "name": "string.quoted.double.algo" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.algo",
          "match": "\\b(if|else|while|for|return|break|continue|switch|case|default|goto)\\b"
        },
        {
          "name": "keyword.other.algo",
          "match": "\\b(func|let|enum|struct|typedef|sizeof)\\b"
        },
        {
          "name": "storage.modifier.algo",
          "match": "\\b(const|static|extern)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.algo",
          "match": "\\b(void|int|char|bool|i64|u64)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.algo",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        },
        {
          "name": "support.function.algo",
          "match": "\\b(print|printInt|printStr|exit)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.algo",
          "match": "\\b(true|false|null)\\b"
        },
        {
          "name": "constant.numeric.algo",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.algo",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.algo",
              "match": "\\\\(n|t|r|\\\\|\"|')"
            }
          ]
        },
        {
          "name": "string.quoted.single.algo",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.algo",
              "match": "\\\\(n|t|r|\\\\|\"|')"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.algo",
          "match": "\\b0x[0-9A-Fa-f]+\\b"
        },
        {
          "name": "constant.numeric.decimal.algo",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.algo",
          "match": "\\+\\+|\\-\\-|\\+|\\-|\\*|\\/|%"
        },
        {
          "name": "keyword.operator.comparison.algo",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.algo",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.assignment.algo",
          "match": "=|\\+=|\\-=|\\*=|\\/=|%="
        },
        {
          "name": "keyword.operator.bitwise.algo",
          "match": "&|\\||\\^|~|<<|>>"
        }
      ]
    }
  }
}
